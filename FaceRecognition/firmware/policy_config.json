    "A-full": {"interval_ms": "adaptive", "model": "small_then_large_on_uncertainty", "quality_gate": true, "imu_motion": true, "camera_sleep_request": true, "temporal_confirmation": "2_of_3"}
  },
  "ablation_protocol": {
    "factors": ["motion", "image_quality_adaptation", "confidence_escalation", "camera_sleep", "temporal_confirmation"],
    "retune_remaining_parameters": false,
