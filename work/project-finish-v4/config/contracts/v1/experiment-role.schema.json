{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-role-v1",
  "title": "Experiment role v1",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "identity_id",
    "role",
    "relative_path",
    "sha256",
    "source_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "experiment-role-1"
    },
    "record_id": {
      "type": "string"
    },
    "identity_id": {
      "type": "string"
    },
    "role": {
      "enum": [
        "train",
        "stopping",
        "threshold_calibration",
        "development",
        "final",
        "unknown_train",
        "unknown_calibration",
        "unknown_development",
        "unknown_final",
        "scene_train",
        "scene_development",
        "scene_final"
      ]
    },
    "identity_partition": {
      "enum": [
        "known",
        "unknown",
        "scene"
      ]
    },
    "relative_path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
